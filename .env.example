# Copy this to `.env` and fill in what you need. Every line is optional: with
# none of them set, the credential-free Tools work exactly as they do now.
#
# `.env` is gitignored. A variable already set in your shell wins over this
# file, so a one-off `GOOGLE_CLIENT_ID=... pnpm login` still overrides it.

# --- Google login (Search Console and Analytics Tools) --------------------
# Create an OAuth client of type "Desktop app" at
# https://console.cloud.google.com/apis/credentials
# See docs/setup.md for the full walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- pagespeed_insights ---------------------------------------------------
# An API key from the same console, with the PageSpeed Insights API enabled.
# Free quota is 25,000 requests a day and needs no billing account.
PAGESPEED_API_KEY=

# --- Optional enrichment --------------------------------------------------
# A Knowledge Graph API key. Without it the entity checks report as not
# evaluated rather than refusing; every other Tool is unaffected.
GOOGLE_KG_API_KEY=

# --- Storage --------------------------------------------------------------
# Where the SQLite database lives. Defaults to db/thatseoagent.sqlite.
# Set to `off` to run with no persistence at all.
# TSA_DB_PATH=

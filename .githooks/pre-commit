#!/bin/sh
# Refuse a commit that does not typecheck or lint.
#
# Both take a few seconds, so this is a gate rather than a wait. The unit and
# e2e suites stay in CI and in `pnpm verify`.
#
# Versioned rather than left in `.git/hooks`, which is not shared: enable it in
# a fresh clone with `pnpm hooks`.
set -e

printf 'pre-commit: typecheck… '
pnpm --silent typecheck
printf 'ok\npre-commit: lint… '
pnpm --silent lint >/dev/null
printf 'ok\n'

{
  "name": "thatseoagent-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing SEO analysis tools. Runs locally over HTTP.",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "xmcp dev",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && vitest run --config vitest.e2e.config.mts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e",
    "hooks": "git config core.hooksPath .githooks",
    "build:raw": "xmcp build",
    "db:generate": "drizzle-kit generate",
    "login": "node dist/login.cjs",
    "home": "node scripts/build-home-page.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.1",
    "google-auth-library": "^11.1.0",
    "p-limit": "^7.3.3",
    "tldts": "^7.4.15",
    "xmcp": "1.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@xmcp-dev/compiler": "1.1.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "main": "./dist/http.js",
  "files": [
    "dist",
    "drizzle",
    "scripts",
    "src/lib/server-address.json"
  ],
  "bin": {
    "thatseoagent-mcp": "./scripts/start.mjs",
    "thatseoagent-mcp-login": "./dist/login.cjs"
  },
  "license": "MIT"
}
